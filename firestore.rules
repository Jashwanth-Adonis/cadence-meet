rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function parentUserExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'vaultSalt', 'vaultVerifier', 'vaultEnabled', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'vaultSalt', 'vaultVerifier', 'vaultEnabled', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid == userId
        && isValidId(data.uid)
        && (!('email' in data) || (data.email is string && data.email.size() <= 254))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && data.vaultSalt is string && data.vaultSalt.size() >= 1 && data.vaultSalt.size() <= 64
        && data.vaultVerifier is string && data.vaultVerifier.size() >= 1 && data.vaultVerifier.size() <= 512
        && data.vaultEnabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFolder(data, userId) {
      return data.keys().hasAll(['ownerId', 'name', 'colorHex', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'description', 'colorHex', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && (!('description' in data) || (data.description is string && data.description.size() <= 240))
        && data.colorHex is string && data.colorHex.size() == 7 && data.colorHex.matches('^#[0-9a-fA-F]{6}$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTags(tags) {
      return tags is list
        && tags.size() <= 10
        && (tags.size() == 0 || (tags[0] is string && tags[0].size() <= 40));
    }

    function isValidMeeting(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'starred', 'archived', 'status', 'durationSec', 'fileSizeBytes',
          'hasLocalVideo', 'videoMimeType', 'speakerCount', 'actionItemCount',
          'tags', 'encryptedPayload', 'payloadIv', 'recordedAtMs', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'folderId', 'starred', 'archived', 'status', 'durationSec', 'fileSizeBytes',
          'hasLocalVideo', 'videoMimeType', 'speakerCount', 'actionItemCount',
          'tags', 'encryptedPayload', 'payloadIv', 'recordedAtMs', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && (!('folderId' in data) || (data.folderId is string && data.folderId.size() <= 128 && data.folderId.matches('^[a-zA-Z0-9_\\-]*$')))
        && data.starred is bool
        && data.archived is bool
        && data.status in ['processing', 'completed', 'archived']
        && data.durationSec is number && data.durationSec >= 0 && data.durationSec <= 86400
        && data.fileSizeBytes is number && data.fileSizeBytes >= 0 && data.fileSizeBytes <= 10737418240
        && data.hasLocalVideo is bool
        && data.videoMimeType is string && data.videoMimeType.size() <= 64
        && data.speakerCount is int && data.speakerCount >= 0 && data.speakerCount <= 100
        && data.actionItemCount is int && data.actionItemCount >= 0 && data.actionItemCount <= 500
        && isValidTags(data.tags)
        && data.encryptedPayload is string && data.encryptedPayload.size() >= 1 && data.encryptedPayload.size() <= 600000
        && data.payloadIv is string && data.payloadIv.size() >= 1 && data.payloadIv.size() <= 64
        && data.recordedAtMs is number && data.recordedAtMs >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTask(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'status', 'priority', 'encryptedTaskData', 'payloadIv', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'meetingId', 'folderId', 'status', 'priority', 'dueDate', 'timestampSec',
          'encryptedTaskData', 'payloadIv', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && (!('meetingId' in data) || (data.meetingId is string && data.meetingId.size() <= 128 && data.meetingId.matches('^[a-zA-Z0-9_\\-]*$')))
        && (!('folderId' in data) || (data.folderId is string && data.folderId.size() <= 128 && data.folderId.matches('^[a-zA-Z0-9_\\-]*$')))
        && data.status in ['backlog', 'in_progress', 'in_review', 'done']
        && data.priority in ['low', 'medium', 'high', 'urgent']
        && (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 32))
        && (!('timestampSec' in data) || (data.timestampSec is number && data.timestampSec >= 0 && data.timestampSec <= 86400))
        && data.encryptedTaskData is string && data.encryptedTaskData.size() >= 1 && data.encryptedTaskData.size() <= 32000
        && data.payloadIv is string && data.payloadIv.size() >= 1 && data.payloadIv.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['vaultSalt', 'vaultVerifier', 'vaultEnabled', 'updatedAt'])
        );
      allow delete: if false;

      match /folders/{folderId} {
        allow get: if isValidId(userId) && isValidId(folderId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(folderId)
          && isVerified()
          && isOwner(userId)
          && isValidFolder(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentUserExists(userId);
        allow update: if isValidId(userId) && isValidId(folderId)
          && isVerified()
          && isOwner(userId)
          && isValidFolder(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'colorHex', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(folderId) && isVerified() && isOwner(userId);
      }

      match /meetings/{meetingId} {
        allow get: if isValidId(userId) && isValidId(meetingId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(meetingId)
          && isVerified()
          && isOwner(userId)
          && isValidMeeting(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentUserExists(userId);
        allow update: if isValidId(userId) && isValidId(meetingId)
          && isVerified()
          && isOwner(userId)
          && isValidMeeting(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (existing().status != 'archived' && incoming().diff(existing()).affectedKeys().hasOnly(['folderId', 'starred', 'tags', 'updatedAt']))
            || (existing().status != 'archived' && incoming().diff(existing()).affectedKeys().hasOnly(['encryptedPayload', 'payloadIv', 'actionItemCount', 'speakerCount', 'status', 'updatedAt']))
            || (existing().status != 'archived' && incoming().diff(existing()).affectedKeys().hasOnly(['hasLocalVideo', 'fileSizeBytes', 'videoMimeType', 'updatedAt']))
            || incoming().diff(existing()).affectedKeys().hasOnly(['archived', 'status', 'updatedAt'])
          );
        allow delete: if isValidId(userId) && isValidId(meetingId) && isVerified() && isOwner(userId);
      }

      match /tasks/{taskId} {
        allow get: if isValidId(userId) && isValidId(taskId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(taskId)
          && isVerified()
          && isOwner(userId)
          && isValidTask(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentUserExists(userId);
        allow update: if isValidId(userId) && isValidId(taskId)
          && isVerified()
          && isOwner(userId)
          && isValidTask(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['priority', 'dueDate', 'folderId', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['encryptedTaskData', 'payloadIv', 'status', 'priority', 'dueDate', 'folderId', 'updatedAt'])
          );
        allow delete: if isValidId(userId) && isValidId(taskId) && isVerified() && isOwner(userId);
      }
    }
  }
}
